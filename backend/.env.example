# ── Copy this file to .env and fill in real values ─────────────────
# NEVER commit .env to git.
# On Vercel, set these values in Project → Settings → Environment Variables.

# Supabase (get from supabase.com → Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_SECRET_KEY_HERE

# Server port (Vercel ignores this; used for local dev only)
PORT=3000

# Leave blank on Vercel. Set to http://localhost:3000 for local dev if needed.
BACKEND_URL=

# Admin login – REQUIRED. Server refuses to start without these.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_strong_password_here

# JWT secret – REQUIRED. Generate with PowerShell:
# -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 64 | %{[char]$_})
JWT_SECRET=replace_with_64_char_random_string

# FRONTEND_URL – leave blank on Vercel (same domain = no CORS needed).
# Set for local dev only if you run frontend on a different port.
# FRONTEND_URL=http://localhost:5500

# SMTP – only needed if sending via Nodemailer instead of Benchmark Email.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=you@gmail.com
